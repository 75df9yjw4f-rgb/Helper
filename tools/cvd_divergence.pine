//@version=6
// CVD Divergence — ищет расхождения между ценой и УЖЕ СТОЯЩИМ на графике
// индикатором кумулятивной дельты. Своей дельты не считает и своего графика
// не рисует: серия берётся через input.source из другого индикатора.
//
// Логика. Экстремумы ищутся по ЦЕНЕ. На тех же самых барах читается значение
// CVD. Четыре случая:
//   на максимумах: цена выше, CVD ниже — обычная медвежья (разворот вниз)
//   на максимумах: цена ниже, CVD выше — скрытая медвежья (продолжение вниз)
//   на минимумах:  цена ниже, CVD выше — обычная бычья (разворот вверх)
//   на минимумах:  цена выше, CVD ниже — скрытая бычья (продолжение вверх)
// Линия проводится по цене между двумя экстремумами, а значения CVD в этих же
// точках выводятся в подписи: видно, куда пошла цена и куда пошла дельта.
//
// Сравнивается не только соседний экстремум, а последние maxPiv штук, иначе
// расхождение между двумя минимумами, разделёнными промежуточными минимумами,
// вообще не попадает в перебор. Найденное совпадение не прекращает перебор:
// один экстремум может дать несколько дивергенций, и все они рисуются.
//
// Установка (ничего перетаскивать не надо):
//   1. В индикаторе CDV поставьте Style = Line. В режиме Candle плот "CDV Line"
//      пустой (в коде ctl присваивается только в ветке Line), и брать оттуда
//      нечего.
//   2. Добавьте этот индикатор. Он ляжет прямо на ценовой график.
//   3. В настройках выберите Источник = "CDV: CDV Line".
//
// Если хочется линию ещё и на панели дельты: в строке indicator() ниже
// поменяйте overlay = true на overlay = false, перенесите скрипт в панель CDV
// и включите в настройках "Линия на панели дельты". Линии на цене при этом
// останутся, они рисуются через force_overlay.
//
// Пивот подтверждается через R баров после экстремума. Раньше неизвестно,
// экстремум ли это, поэтому линия и появляется с задержкой.
//
// Дополнительно: пара настраиваемых EMA с отметкой пересечений. Пересечение
// помечается ярко, если оно случилось вскоре после дивергенции той же стороны,
// и приглушённо, если само по себе.
indicator("CVD Divergence", "CVD div", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ─────────────────────────────── Источник
src = input.source(close, "Источник: плот CVD с графика", tooltip = "Выберите плот индикатора кумулятивной дельты, например CDV: CDV Line")

// ─────────────────────────────── Дивергенции
gP = "Дивергенции"
piv      = input.int(5,   "Пивот: баров слева", minval = 1, group = gP)
pivR     = input.int(5,   "Пивот: баров справа (задержка подтверждения)", minval = 1, group = gP)
minGap   = input.int(5,   "Мин. расстояние между экстремумами, баров", minval = 1, group = gP)
maxGap   = input.int(150, "Макс. расстояние между экстремумами, баров", minval = 2, group = gP)
maxPiv   = input.int(5,   "Сколько прошлых экстремумов сравнивать", minval = 1, maxval = 20, group = gP, tooltip = "1 = только соседний экстремум. Больше = ловит дивергенции через промежуточные пики.")
allPairs = input.bool(true, "Искать все совпадения, а не первое", group = gP, tooltip = "Выключить, если график перегружен: тогда на каждый экстремум рисуется только одна линия.")
useBear  = input.bool(true, "Обычные медвежьи: на максимумах цена выше, CVD ниже", group = gP)
useBull  = input.bool(true, "Обычные бычьи: на минимумах цена ниже, CVD выше", group = gP)
useHidB  = input.bool(true, "Скрытые медвежьи: на максимумах цена ниже, CVD выше", group = gP)
useHidL  = input.bool(true, "Скрытые бычьи: на минимумах цена выше, CVD ниже", group = gP)

// ─────────────────────────────── Отображение
gV = "Отображение"
onCvd    = input.bool(false, "Линия на панели дельты (только если overlay = false)", group = gV)
onPrice  = input.bool(true, "Линия на графике цены",  group = gV)
showLbl  = input.bool(true, "Подписи", group = gV)
lw       = input.int(2, "Толщина линии", minval = 1, maxval = 4, group = gV)
keepN    = input.int(60, "Сколько последних линий держать", minval = 1, group = gV)
showInfo = input.bool(true, "Строка состояния", group = gV)
cBear    = input.color(#f23645, "Медвежья", inline = "c", group = gV)
cBull    = input.color(#089981, "Бычья",    inline = "c", group = gV)

// ─────────────────────────────── EMA
gE = "EMA"
useEma   = input.bool(true, "Показывать EMA", group = gE)
emaSrc   = input.source(close, "Цена для EMA", group = gE)
len1     = input.int(9,  "Быстрая", minval = 1, inline = "l", group = gE)
len2     = input.int(21, "Медленная", minval = 1, inline = "l", group = gE)
showX    = input.bool(true, "Отмечать пересечения", group = gE)
onlyConf = input.bool(false, "Только пересечения, совпавшие с дивергенцией", group = gE)
confBars = input.int(20, "Окно совпадения с дивергенцией, баров", minval = 1, group = gE)
cE1      = input.color(#2962ff, "Быстрая", inline = "ce", group = gE)
cE2      = input.color(#ff9800, "Медленная", inline = "ce", group = gE)

// ─────────────────────────────── Память по экстремумам
// Хранятся последние maxPiv экстремумов каждого типа, а не один предыдущий.
// Иначе дивергенция между минимумами, разделёнными промежуточными минимумами,
// никогда не попадёт в сравнение.
var array<int>   phB = array.new<int>()
var array<float> phP = array.new<float>()
var array<float> phC = array.new<float>()
var array<int>   plB = array.new<int>()
var array<float> plP = array.new<float>()
var array<float> plC = array.new<float>()

var array<line>  lns = array.new<line>()
var array<label> lbs = array.new<label>()

// Компактная запись больших чисел для подписей
f_n(float v) =>
    float a = math.abs(v)
    a >= 1e9 ? str.tostring(v / 1e9, "#.##") + "B" : a >= 1e6 ? str.tostring(v / 1e6, "#.##") + "M" : a >= 1e3 ? str.tostring(v / 1e3, "#.#") + "K" : str.tostring(v, "#.#")

// Рисует пару линий: по цене и, если включено, по дельте
f_mark(int b1, float p1, float c1, int b2, float p2, float c2, color col, string txt, bool atHigh) =>
    string st = atHigh ? label.style_label_down : label.style_label_up
    if onCvd
        array.push(lns, line.new(b1, c1, b2, c2, xloc = xloc.bar_index, color = col, width = lw))
        if showLbl
            array.push(lbs, label.new(b2, c2, txt, xloc = xloc.bar_index, yloc = yloc.price, style = st, color = color.new(col, 15), textcolor = color.white, size = size.tiny))
    if onPrice
        array.push(lns, line.new(b1, p1, b2, p2, xloc = xloc.bar_index, color = col, width = lw, force_overlay = true))
        if showLbl
            array.push(lbs, label.new(b2, p2, txt, xloc = xloc.bar_index, yloc = yloc.price, style = st, color = color.new(col, 15), textcolor = color.white, size = size.tiny, force_overlay = true))
    0

// ─────────────────────────────── Поиск
float ph = ta.pivothigh(high, piv, pivR)
float pl = ta.pivotlow(low,  piv, pivR)

bool bearReg = false
bool bearHid = false
bool bullReg = false
bool bullHid = false

var int cntBear = 0
var int cntBull = 0

// Максимумы. Перебор идёт от самого старого экстремума к новым и по умолчанию
// не останавливается на первом совпадении: один экстремум может образовать
// дивергенцию сразу с несколькими предыдущими, и одна не должна скрывать другие.
if not na(ph) and not na(src[pivR])
    int   bNow = bar_index - pivR
    float pNow = ph
    float cNow = src[pivR]
    if array.size(phB) > 0
        for i = 0 to array.size(phB) - 1
            int   b0 = array.get(phB, i)
            float p0 = array.get(phP, i)
            float c0 = array.get(phC, i)
            int   gp = bNow - b0
            if gp >= minGap and gp <= maxGap
                bool reg = useBear and pNow > p0 and cNow < c0
                bool hid = useHidB and pNow < p0 and cNow > c0
                if reg or hid
                    bearReg := bearReg or reg
                    bearHid := bearHid or hid
                    cntBear := cntBear + 1
                    string t = (reg ? "CVD div " : "CVD скр. ") + f_n(c0) + " -> " + f_n(cNow)
                    int drawn = f_mark(b0, p0, c0, bNow, pNow, cNow, cBear, t, true)
                    if not allPairs
                        break
    array.push(phB, bNow)
    array.push(phP, pNow)
    array.push(phC, cNow)
    while array.size(phB) > maxPiv
        array.shift(phB)
        array.shift(phP)
        array.shift(phC)

// Минимумы
if not na(pl) and not na(src[pivR])
    int   bNow = bar_index - pivR
    float pNow = pl
    float cNow = src[pivR]
    if array.size(plB) > 0
        for i = 0 to array.size(plB) - 1
            int   b0 = array.get(plB, i)
            float p0 = array.get(plP, i)
            float c0 = array.get(plC, i)
            int   gp = bNow - b0
            if gp >= minGap and gp <= maxGap
                bool reg = useBull and pNow < p0 and cNow > c0
                bool hid = useHidL and pNow > p0 and cNow < c0
                if reg or hid
                    bullReg := bullReg or reg
                    bullHid := bullHid or hid
                    cntBull := cntBull + 1
                    string t = (reg ? "CVD div " : "CVD скр. ") + f_n(c0) + " -> " + f_n(cNow)
                    int drawn = f_mark(b0, p0, c0, bNow, pNow, cNow, cBull, t, false)
                    if not allPairs
                        break
    array.push(plB, bNow)
    array.push(plP, pNow)
    array.push(plC, cNow)
    while array.size(plB) > maxPiv
        array.shift(plB)
        array.shift(plP)
        array.shift(plC)

bool bear = bearReg or bearHid
bool bull = bullReg or bullHid

// ─────────────────────────────── EMA и пересечения
// Считается после поиска дивергенций, чтобы можно было проверить совпадение.
float e1 = ta.ema(emaSrc, len1)
float e2 = ta.ema(emaSrc, len2)

bool xUp = ta.crossover(e1, e2)
bool xDn = ta.crossunder(e1, e2)

var int lastBear = -1
var int lastBull = -1
if bear
    lastBear := bar_index
if bull
    lastBull := bar_index

// Пересечение считается подтверждённым, если дивергенция той же стороны была
// не раньше чем confBars баров назад. Дивергенция подтверждается с задержкой
// в pivR баров, поэтому окно должно быть заметно больше пивота.
bool confUp = xUp and lastBull >= 0 and bar_index - lastBull <= confBars
bool confDn = xDn and lastBear >= 0 and bar_index - lastBear <= confBars

bool drawUp = showX and (onlyConf ? confUp : xUp)
bool drawDn = showX and (onlyConf ? confDn : xDn)

plot(useEma ? e1 : na, "EMA быстрая",   color = cE1, linewidth = 1)
plot(useEma ? e2 : na, "EMA медленная", color = cE2, linewidth = 1)

plotshape(drawUp, "Пересечение вверх", style = shape.triangleup,   location = location.belowbar, color = confUp ? cBull : color.new(cBull, 45), size = size.tiny)
plotshape(drawDn, "Пересечение вниз",  style = shape.triangledown, location = location.abovebar, color = confDn ? cBear : color.new(cBear, 45), size = size.tiny)

// Старые отрисовки удаляются, иначе упрёмся в лимит объектов
int maxObj = math.max(keepN, 2)
while array.size(lns) > maxObj
    line.delete(array.shift(lns))
while array.size(lbs) > maxObj
    label.delete(array.shift(lbs))

// Невидимый плот источника. На масштаб не влияет (display.none), нужен только
// чтобы в режиме overlay = false панель скрипта имела масштаб дельты.
plot(src, "Источник", color = color.new(color.gray, 100), display = display.none, editable = false)

// ─────────────────────────────── Строка состояния
var table inf = table.new(position.bottom_right, 1, 3, frame_color = color.new(color.gray, 60), frame_width = 1, border_color = color.new(color.gray, 80), border_width = 1)

if showInfo and barstate.islast
    bool noSrc  = na(src)
    bool isPrice = src == close and src[1] == close[1] and src[2] == close[2]
    string s = noSrc ? "ИСТОЧНИК ПУСТ: в CDV поставьте Style = Line" : isPrice ? "ИСТОЧНИК = close: выберите плот CDV" : "источник подключён"
    table.cell(inf, 0, 0, s, text_color = (noSrc or isPrice) ? cBear : color.gray, text_size = size.tiny)
    table.cell(inf, 0, 1, "дивергенций: " + str.tostring(cntBear) + " медв. / " + str.tostring(cntBull) + " быч.", text_color = color.gray, text_size = size.tiny)
    string emaTxt = not useEma ? "EMA выключены" : "EMA " + str.tostring(len1) + "/" + str.tostring(len2) + ": " + (e1 > e2 ? "быстрая выше" : "быстрая ниже")
    table.cell(inf, 0, 2, emaTxt, text_color = useEma ? (e1 > e2 ? cBull : cBear) : color.gray, text_size = size.tiny)

// ─────────────────────────────── Алерты
alertcondition(bearReg, "Медвежья CVD-дивергенция",        "Цена обновила максимум, CVD — нет")
alertcondition(bullReg, "Бычья CVD-дивергенция",           "Цена обновила минимум, CVD — нет")
alertcondition(bearHid, "Скрытая медвежья CVD-дивергенция", "Максимум цены ниже, максимум CVD выше")
alertcondition(bullHid, "Скрытая бычья CVD-дивергенция",    "Минимум цены выше, минимум CVD ниже")
alertcondition(xUp,     "Пересечение EMA вверх",  "Быстрая EMA пересекла медленную снизу вверх")
alertcondition(xDn,     "Пересечение EMA вниз",   "Быстрая EMA пересекла медленную сверху вниз")
alertcondition(confUp,  "EMA вверх после бычьей дивергенции",   "Пересечение EMA вверх вскоре после бычьей CVD-дивергенции")
alertcondition(confDn,  "EMA вниз после медвежьей дивергенции", "Пересечение EMA вниз вскоре после медвежьей CVD-дивергенции")
