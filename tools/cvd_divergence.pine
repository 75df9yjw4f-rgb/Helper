//@version=6
// CVD Divergence — ищет расхождения между ценой и УЖЕ СТОЯЩИМ на графике
// индикатором кумулятивной дельты. Своей дельты не считает и своего графика
// не рисует: серия берётся через input.source из другого индикатора.
//
// Логика. Экстремумы ищутся по ЦЕНЕ. На тех же самых барах читается значение
// CVD. Цена выше, CVD ниже — медвежья дивергенция. Цена ниже, CVD выше — бычья.
// Проводятся две линии между одними и теми же двумя барами: на панели дельты
// и на ценовом графике (через force_overlay).
//
// Установка:
//   1. В индикаторе CDV поставьте Style = Line. В режиме Candle плот "CDV Line"
//      пустой (в коде ctl присваивается только в ветке Line), и брать оттуда
//      нечего.
//   2. Добавьте этот индикатор, перетащите его в панель к CDV (Move to ->
//      существующая панель), чтобы линии легли на саму дельту.
//   3. В настройках выберите Источник = "CDV: CDV Line".
//
// Пивот подтверждается через R баров после экстремума. Раньше неизвестно,
// экстремум ли это, поэтому линия и появляется с задержкой.
indicator("CVD Divergence", "CVD div", overlay = false, max_lines_count = 500, max_labels_count = 500)

// ─────────────────────────────── Источник
src = input.source(close, "Источник: плот CVD с графика", tooltip = "Выберите плот индикатора кумулятивной дельты, например CDV: CDV Line")

// ─────────────────────────────── Дивергенции
gP = "Дивергенции"
piv     = input.int(5,   "Пивот: баров слева", minval = 1, group = gP)
pivR    = input.int(5,   "Пивот: баров справа (задержка подтверждения)", minval = 1, group = gP)
minGap  = input.int(5,   "Мин. расстояние между экстремумами, баров", minval = 1, group = gP)
maxGap  = input.int(100, "Макс. расстояние между экстремумами, баров", minval = 2, group = gP)
useBear = input.bool(true, "Медвежьи: цена выше, CVD ниже", group = gP)
useBull = input.bool(true, "Бычьи: цена ниже, CVD выше", group = gP)

// ─────────────────────────────── Отображение
gV = "Отображение"
onCvd    = input.bool(true, "Линия на панели дельты", group = gV)
onPrice  = input.bool(true, "Линия на графике цены",  group = gV)
showLbl  = input.bool(true, "Подписи", group = gV)
lw       = input.int(2, "Толщина линии", minval = 1, maxval = 4, group = gV)
keepN    = input.int(20, "Сколько последних дивергенций держать", minval = 1, group = gV)
showInfo = input.bool(true, "Строка состояния", group = gV)
cBear    = input.color(#f23645, "Медвежья", inline = "c", group = gV)
cBull    = input.color(#089981, "Бычья",    inline = "c", group = gV)

// ─────────────────────────────── Память по экстремумам
var int   hB1 = 0
var float hP1 = 0.0
var float hC1 = 0.0
var int   hB2 = 0
var float hP2 = 0.0
var float hC2 = 0.0
var int   hN  = 0

var int   lB1 = 0
var float lP1 = 0.0
var float lC1 = 0.0
var int   lB2 = 0
var float lP2 = 0.0
var float lC2 = 0.0
var int   lN  = 0

var array<line>  lns = array.new<line>()
var array<label> lbs = array.new<label>()

// ─────────────────────────────── Поиск
float ph = ta.pivothigh(high, piv, pivR)
float pl = ta.pivotlow(low,  piv, pivR)

bool bear = false
bool bull = false

var int cntBear = 0
var int cntBull = 0

if not na(ph) and not na(src[pivR])
    hB1 := hB2
    hP1 := hP2
    hC1 := hC2
    hB2 := bar_index - pivR
    hP2 := ph
    hC2 := src[pivR]
    hN  := hN + 1
    int gapH = hB2 - hB1
    if useBear and hN >= 2 and gapH >= minGap and gapH <= maxGap and hP2 > hP1 and hC2 < hC1
        bear := true
        cntBear := cntBear + 1
        if onCvd
            array.push(lns, line.new(hB1, hC1, hB2, hC2, xloc = xloc.bar_index, color = cBear, width = lw))
            if showLbl
                array.push(lbs, label.new(hB2, hC2, "CVD div", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_down, color = color.new(cBear, 15), textcolor = color.white, size = size.tiny))
        if onPrice
            array.push(lns, line.new(hB1, hP1, hB2, hP2, xloc = xloc.bar_index, color = cBear, width = lw, force_overlay = true))
            if showLbl
                array.push(lbs, label.new(hB2, hP2, "CVD div", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_down, color = color.new(cBear, 15), textcolor = color.white, size = size.tiny, force_overlay = true))

if not na(pl) and not na(src[pivR])
    lB1 := lB2
    lP1 := lP2
    lC1 := lC2
    lB2 := bar_index - pivR
    lP2 := pl
    lC2 := src[pivR]
    lN  := lN + 1
    int gapL = lB2 - lB1
    if useBull and lN >= 2 and gapL >= minGap and gapL <= maxGap and lP2 < lP1 and lC2 > lC1
        bull := true
        cntBull := cntBull + 1
        if onCvd
            array.push(lns, line.new(lB1, lC1, lB2, lC2, xloc = xloc.bar_index, color = cBull, width = lw))
            if showLbl
                array.push(lbs, label.new(lB2, lC2, "CVD div", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_up, color = color.new(cBull, 15), textcolor = color.white, size = size.tiny))
        if onPrice
            array.push(lns, line.new(lB1, lP1, lB2, lP2, xloc = xloc.bar_index, color = cBull, width = lw, force_overlay = true))
            if showLbl
                array.push(lbs, label.new(lB2, lP2, "CVD div", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_up, color = color.new(cBull, 15), textcolor = color.white, size = size.tiny, force_overlay = true))

// Старые отрисовки удаляются, иначе упрёмся в лимит объектов
int perDiv = (onCvd ? 1 : 0) + (onPrice ? 1 : 0)
int maxObj = math.max(keepN * math.max(perDiv, 1), 2)
while array.size(lns) > maxObj
    line.delete(array.shift(lns))
while array.size(lbs) > maxObj
    label.delete(array.shift(lbs))

// Невидимый плот: чтобы панель имела масштаб дельты, даже если её не слили с CDV
plot(src, "Источник", color = color.new(color.gray, 100), display = display.none, editable = false)

// ─────────────────────────────── Строка состояния
var table inf = table.new(position.bottom_right, 1, 2, frame_color = color.new(color.gray, 60), frame_width = 1, border_color = color.new(color.gray, 80), border_width = 1)

if showInfo and barstate.islast
    bool noSrc  = na(src)
    bool isPrice = src == close and src[1] == close[1] and src[2] == close[2]
    string s = noSrc ? "ИСТОЧНИК ПУСТ: в CDV поставьте Style = Line" : isPrice ? "ИСТОЧНИК = close: выберите плот CDV" : "источник подключён"
    table.cell(inf, 0, 0, s, text_color = (noSrc or isPrice) ? cBear : color.gray, text_size = size.tiny)
    table.cell(inf, 0, 1, "дивергенций: " + str.tostring(cntBear) + " медв. / " + str.tostring(cntBull) + " быч.", text_color = color.gray, text_size = size.tiny)

// ─────────────────────────────── Алерты
alertcondition(bear, "Медвежья CVD-дивергенция", "Цена обновила максимум, CVD — нет")
alertcondition(bull, "Бычья CVD-дивергенция",    "Цена обновила минимум, CVD — нет")
